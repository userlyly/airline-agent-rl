# Secrets and machine paths for held-out evaluation. Copy to .env (gitignored).
#
# Only the user simulator needs an API key: the agent is the local vLLM endpoint
# and tau2's airline scoring (DB + COMMUNICATE) runs entirely locally.
# scripts/eval/run_base_test20.sh reads these; if you already keep them in the
# tau2 checkout's .env, point AIRLINE_RL_ENV_FILE at that file instead.

# User simulator credentials (litellm reads OPENAI_API_KEY).
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://ai.ahzm.top/v1

# Local paths. TAU2_DIR must be an upstream checkout at the commit pinned in
# configs/tau2.lock.json; the run script refuses any other commit.
TAU2_DIR=../tau2-bench

# Optional: source this file instead of exporting the variables above.
# AIRLINE_RL_ENV_FILE=/path/to/tau2-bench/.env
